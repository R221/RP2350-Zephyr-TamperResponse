/*
 * Devicetree overlay for the tamper-response firmware.
 *
 * This file describes OUR custom hardware to Zephyr: the tamper input pin.
 * Zephyr's devicetree already knows about the board's built-in things (like
 * the onboard LED, led0), but it doesn't know we've wired a reed switch to
 * GPIO7. This overlay adds that information so our code can refer to the
 * tamper pin by name instead of hardcoding pin numbers.
 */

/ {
	tamper {
		compatible = "gpio-keys";
		tamper_switch: tamper_switch {
			gpios = <&gpio0 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
			label = "Tamper Switch";
		};
	};
};